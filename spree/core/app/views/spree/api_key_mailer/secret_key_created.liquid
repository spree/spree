---
subject: "{{ 'api_key_mailer.secret_key_created.subject' | t: store_name: store.name }}"
---
{% assign created_at = api_key.created_at | date: '%Y-%m-%d %H:%M %Z' %}
{% assign key_preview = api_key.token_prefix | append: '…' %}
{% assign scopes = api_key.scopes | join: ', ' %}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'api_key_mailer.secret_key_created.heading' | t: store_name: store.name }}</mj-text>
    {% if user.first_name != blank %}<mj-text mj-class="greeting">{{ 'api_key_mailer.secret_key_created.greeting' | t: name: user.first_name }}</mj-text>{% endif %}
    {% if api_key.created_by_name != blank %}
      <mj-text mj-class="lead">{{ 'api_key_mailer.secret_key_created.message' | t: creator_name: api_key.created_by_name, key_name: api_key.name, store_name: store.name }}</mj-text>
    {% else %}
      <mj-text mj-class="lead">{{ 'api_key_mailer.secret_key_created.message_without_creator' | t: key_name: api_key.name, store_name: store.name }}</mj-text>
    {% endif %}
    <mj-text mj-class="lead">{{ 'api_key_mailer.secret_key_created.warning' | t }}</mj-text>
    <mj-button href="{{ review_url }}">{{ 'api_key_mailer.secret_key_created.action' | t }}</mj-button>
  </mj-column>
</mj-section>
<mj-section padding="48px 0 0">
  <mj-column>
    <mj-table css-class="summary">
      {% render 'spree/shared/summary_row', label: 'api_key_mailer.secret_key_created.name_label', value: api_key.name, translate: true %}
      {% render 'spree/shared/summary_row', label: 'api_key_mailer.secret_key_created.key_label', value: key_preview, translate: true %}
      {% if scopes != blank %}{% render 'spree/shared/summary_row', label: 'api_key_mailer.secret_key_created.scopes_label', value: scopes, translate: true %}{% endif %}
      {% if api_key.created_by_name != blank %}{% render 'spree/shared/summary_row', label: 'api_key_mailer.secret_key_created.created_by_label', value: api_key.created_by_name, translate: true %}{% endif %}
      {% render 'spree/shared/summary_row', label: 'api_key_mailer.secret_key_created.created_at_label', value: created_at, translate: true %}
      {% if api_key.created_by_ip_address != blank %}{% render 'spree/shared/summary_row', label: 'api_key_mailer.secret_key_created.ip_address_label', value: api_key.created_by_ip_address, translate: true %}{% endif %}
    </mj-table>
  </mj-column>
</mj-section>
