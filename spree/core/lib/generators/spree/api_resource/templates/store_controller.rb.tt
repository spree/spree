module Spree
  module Api
    module V3
      module Store
        class <%= plural_name.camelize %>Controller < ResourceController
<% if writable? -%>
          # What create and update accept: the controller permits from it, and
          # the integration spec documents it (`request_body_for`), which is
          # where the SDK request types come from.
          request_params :<%= singular_name %> do |body|
<% request_param_attributes.each do |name, type| -%>
            body.attribute :<%= name %>, :<%= type %>
<% end -%>
          end

<% end -%>
          protected

          def model_class
            Spree::<%= class_name.demodulize %>
          end

<% if store_external_name != bare_class_name -%>
          def serializer_class
            Spree::Api::V3::<%= store_external_name %>Serializer
          end
<% else -%>
          def serializer_class
            Spree::Api::V3::<%= bare_class_name %>Serializer
          end
<% end -%>
        end
      end
    end
  end
end
