# frozen_string_literal: true

require 'swagger_helper'

# Documents the <%= plural_name.humanize(capitalize: false) %> Admin API in openapi/admin.yaml (`spree task
# openapi:generate`). The SDK request types come from these operations, and
# each action other than create, read, update and delete becomes an agent tool.
RSpec.describe '<%= plural_name.humanize %> Admin API', type: :request, swagger_doc: 'openapi/admin.yaml' do
  let!(:<%= singular_name %>) { create(:<%= singular_name %>) }

  path '/api/v3/admin/<%= plural_name %>' do
    get 'List <%= plural_name.humanize(capitalize: false) %>' do
      tags '<%= plural_name.humanize %>'
      admin_operation :read, :<%= plural_name %>, description: 'Lists the <%= plural_name.humanize(capitalize: false) %>.'
      parameter name: :page, in: :query, type: :integer, required: false, description: 'Page number'
      parameter name: :limit, in: :query, type: :integer, required: false, description: 'Number of records per page'
      filter_parameters_for

      response '200', '<%= plural_name.humanize(capitalize: false) %> found' do
        run_test! do |response|
          expect(JSON.parse(response.body)['data'].map { |record| record['id'] }).to include(<%= singular_name %>.prefixed_id)
        end
      end
    end

    post 'Create a <%= singular_name.humanize(capitalize: false) %>' do
      tags '<%= plural_name.humanize %>'
      admin_operation :write, :<%= plural_name %>, description: 'Creates a <%= singular_name.humanize(capitalize: false) %>.'
      request_body_for

      response '201', '<%= singular_name.humanize(capitalize: false) %> created' do
        let(:body) { attributes_for(:<%= singular_name %>).slice(<%= permitted_attribute_names.map { |a| ":#{a}" }.join(', ') %>)<%= decimal_attribute_names.map { |a| ".merge(#{a}: '1.00')" }.join %> }

        run_test!
      end
    end
  end

  path '/api/v3/admin/<%= plural_name %>/{id}' do
    parameter name: :id, in: :path, type: :string, required: true, description: '<%= singular_name.humanize %> ID'

    let(:id) { <%= singular_name %>.prefixed_id }

    get 'Get a <%= singular_name.humanize(capitalize: false) %>' do
      tags '<%= plural_name.humanize %>'
      admin_operation :read, :<%= plural_name %>, description: 'Returns a <%= singular_name.humanize(capitalize: false) %>.'

      response '200', '<%= singular_name.humanize(capitalize: false) %> found' do
        run_test!
      end
    end

    patch 'Update a <%= singular_name.humanize(capitalize: false) %>' do
      tags '<%= plural_name.humanize %>'
      admin_operation :write, :<%= plural_name %>, description: 'Updates a <%= singular_name.humanize(capitalize: false) %>.'
      request_body_for

      response '200', '<%= singular_name.humanize(capitalize: false) %> updated' do
        let(:body) { attributes_for(:<%= singular_name %>).slice(<%= permitted_attribute_names.map { |a| ":#{a}" }.join(', ') %>)<%= decimal_attribute_names.map { |a| ".merge(#{a}: '1.00')" }.join %> }

        run_test!
      end
    end

    delete 'Delete a <%= singular_name.humanize(capitalize: false) %>' do
      tags '<%= plural_name.humanize %>'
      admin_operation :write, :<%= plural_name %>, description: 'Deletes a <%= singular_name.humanize(capitalize: false) %>.'

      response '204', '<%= singular_name.humanize(capitalize: false) %> deleted' do
        run_test!
      end
    end
  end
end
