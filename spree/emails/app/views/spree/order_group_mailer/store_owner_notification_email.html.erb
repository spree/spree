<%= render 'spree/shared/purchased_items_styles' %>

<%= render layout: 'spree/shared/mailer_hero' do %>
  <h1><%= Spree.t('order_group_mailer.store_owner_notification_email.heading') %></h1>
  <p><%= Spree.t('order_group_mailer.store_owner_notification_email.instructions', count: @order_group.orders.size) %></p>
<% end %>

<%= render 'spree/shared/order_summary_section',
           heading: Spree.t('order_group_mailer.store_owner_notification_email.purchase_summary', number: @order_group.number),
           line_items: @order_group.line_items,
           order: @order_group,
           totals: false %>

<%= render 'spree/shared/purchase_totals', order_group: @order_group %>
