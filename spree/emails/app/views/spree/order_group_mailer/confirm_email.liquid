---
subject: "{% if resend %}[{{ 'resend' | t | upcase }}] {% endif %}{{ store.name }} {{ 'order_group_mailer.confirm_email.subject' | t }} #{{ order_group.number }}"
---
{% assign customer = 'customer' | t %}
{% assign customer_name = order_group.customer_name | default: customer %}
{% assign parcel_count = order_group.fulfillment_groups.size %}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'order_group_mailer.confirm_email.subject' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'order_group_mailer.confirm_email.dear_customer' | t: name: customer_name }}</mj-text>
    <mj-text mj-class="lead">{{ 'order_group_mailer.confirm_email.instructions' | t: number: order_group.number }}</mj-text>
    {%- comment -%}Counted from the parcels, never from the orders the checkout divided into: several sellers shipping out of one warehouse send one box.{%- endcomment -%}
    {% if parcel_count > 1 %}
      <mj-text mj-class="lead">{{ 'order_group_mailer.confirm_email.arriving_separately' | t: count: parcel_count }}</mj-text>
    {% endif %}
  </mj-column>
</mj-section>
{% if order_group.po_number != blank %}
<mj-section padding="48px 0 0">
  <mj-column>
    <mj-text mj-class="body" padding="0">{{ 'order_mailer.po_number' | t: number: order_group.po_number }}</mj-text>
  </mj-column>
</mj-section>
{% endif %}
{% for group in order_group.fulfillment_groups %}
  {% render 'spree/shared/fulfillment_group', group: group, position: forloop.index, count: parcel_count %}
{% endfor %}
{% if order_group.unfulfilled_items.size > 0 %}
  {% assign heading = 'order_group_mailer.nothing_to_ship' | t %}
  {% render 'spree/shared/order_summary', heading: heading, purchase: order_group, items: order_group.unfulfilled_items, totals: false %}
{% endif %}
<mj-section padding="48px 0 0">
  <mj-column>
    <mj-text mj-class="section-heading" padding="0">{{ 'order_summary' | t }}</mj-text>
    {% render 'spree/shared/purchase_totals', purchase: order_group %}
  </mj-column>
</mj-section>
