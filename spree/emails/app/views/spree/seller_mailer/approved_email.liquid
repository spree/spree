---
subject: "{{ 'seller_mailer.approved_email.subject' | t: store_name: store.name }}"
---
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'seller_mailer.approved_email.heading' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'seller_mailer.greeting' | t: seller_name: seller.name }}</mj-text>
    <mj-text mj-class="lead">{{ 'seller_mailer.approved_email.message' | t: store_name: store.name }}</mj-text>
    {% if dashboard_url %}
      <mj-button href="{{ dashboard_url }}">{{ 'seller_mailer.approved_email.action' | t }}</mj-button>
    {% endif %}
  </mj-column>
</mj-section>
