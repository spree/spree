---
subject: "{{ store.name }} {{ 'customer_mailer.password_reset_email.subject' | t }}"
---
{% assign name = customer.first_name | default: customer.email %}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'customer_mailer.password_reset_email.action' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'customer_mailer.password_reset_email.greeting' | t: name: name }}</mj-text>
    <mj-text mj-class="lead">{{ 'customer_mailer.password_reset_email.instructions' | t }}</mj-text>
    <mj-button href="{{ reset_url }}">{{ 'customer_mailer.password_reset_email.action' | t }}</mj-button>
    <mj-text mj-class="note">{{ 'customer_mailer.password_reset_email.expiry_notice' | t }}</mj-text>
    <mj-text mj-class="note" padding="16px 0 0">{{ 'customer_mailer.password_reset_email.ignore_notice' | t }}</mj-text>
  </mj-column>
</mj-section>
