---
subject: "{{ 'newsletter_mailer.email_confirmation.subject' | t }}"
---
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'newsletter_mailer.email_confirmation.subject' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'newsletter_mailer.email_confirmation.dear_customer' | t }}</mj-text>
    <mj-text mj-class="lead">{{ 'newsletter_mailer.email_confirmation.instructions' | t }}</mj-text>
    <mj-button href="{{ confirmation_url }}">{{ 'newsletter_mailer.email_confirmation.verify_email_address_link' | t }}</mj-button>
    <mj-text mj-class="note">{{ 'newsletter_mailer.email_confirmation.message_copy_link' | t }}<br /><a href="{{ confirmation_url }}">{{ confirmation_url }}</a></mj-text>
    <mj-text mj-class="note" padding="16px 0 0">{{ 'newsletter_mailer.email_confirmation.ignore_disclaimer' | t }}</mj-text>
  </mj-column>
</mj-section>
