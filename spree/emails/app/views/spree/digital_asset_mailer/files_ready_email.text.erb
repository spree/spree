<%= Spree.t('digital_asset_mailer.files_ready_email.dear_customer', name: name_for(@order)) %>

<%= Spree.t('digital_asset_mailer.files_ready_email.instructions', number: @order.number) %>

<% @digital_links.each do |digital_link| %>
<%= digital_link.filename %>
<%= digital_link_download_url(digital_link) %>
<% if digital_link.expires_at %><%= Spree.t('digital_asset_mailer.files_ready_email.available_until', date: l(digital_link.expires_at.to_date, format: :long)) %>
<% end %>
<% end %>
