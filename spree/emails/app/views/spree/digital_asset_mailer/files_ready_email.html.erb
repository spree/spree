<%= render layout: 'spree/shared/mailer_hero' do %>
  <h1><%= Spree.t('digital_asset_mailer.files_ready_email.subject') %></h1>
  <p class="greeting"><%= Spree.t('digital_asset_mailer.files_ready_email.dear_customer', name: name_for(@order)) %></p>
  <p><%= Spree.t('digital_asset_mailer.files_ready_email.instructions', number: @order.number) %></p>
<% end %>

<table width="100%" cellpadding="0" cellspacing="0" border="0">
  <% @digital_links.each do |digital_link| %>
    <tr>
      <td style="padding: 8px 0;">
        <a href="<%= digital_link_download_url(digital_link, @download_host) %>"><%= digital_link.filename %></a>
        <% if digital_link.expires_at %>
          <div style="font-size: 12px; color: #666;">
            <%= Spree.t('digital_asset_mailer.files_ready_email.available_until', date: l(digital_link.expires_at.to_date, format: :long)) %>
          </div>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
