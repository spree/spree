---
subject: "{% if resend %}[{{ 'resend' | t }}] {% endif %}{{ store.name }} {{ 'fulfillment_mailer.delivered_email.subject' | t }} #{{ order.number }}"
---
{% assign heading = 'fulfillment_mailer.delivered_email.items_heading' | t %}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'fulfillment_mailer.delivered_email.subject' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'fulfillment_mailer.delivered_email.dear_customer' | t: name: order.customer_name }}</mj-text>
    <mj-text mj-class="lead">{{ 'fulfillment_mailer.delivered_email.instructions' | t: number: order.number }}</mj-text>
    {% if fulfillment.tracking != blank %}
      <mj-text mj-class="lead">{{ 'fulfillment_mailer.delivered_email.track_information' | t: tracking: fulfillment.tracking }}</mj-text>
    {% endif %}
    {% if fulfillment.tracking_url != blank %}
      <mj-button href="{{ fulfillment.tracking_url }}">{{ fulfillment.tracking | default: fulfillment.tracking_url }}</mj-button>
    {% endif %}
    {% if store.support_email != blank %}
      <mj-text mj-class="note">{{ 'fulfillment_mailer.delivered_email.not_received' | t }} <a href="mailto:{{ store.support_email }}">{{ 'fulfillment_mailer.delivered_email.let_us_know' | t }}</a></mj-text>
    {% endif %}
  </mj-column>
</mj-section>
{% render 'spree/shared/order_summary', heading: heading, purchase: order, items: fulfillment.manifest_items, totals: false %}
