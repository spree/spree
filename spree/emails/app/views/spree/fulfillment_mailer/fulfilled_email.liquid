---
subject: "{% if resend %}[{{ 'resend' | t | upcase }}] {% endif %}{{ store.name }} {{ 'fulfillment_mailer.fulfilled_email.subject' | t }} #{{ order.number }}"
---
{% assign heading = 'fulfillment_mailer.fulfilled_email.fulfillment_summary' | t %}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'fulfillment_mailer.fulfilled_email.subject' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'fulfillment_mailer.fulfilled_email.dear_customer' | t: name: order.customer_name }}</mj-text>
    <mj-text mj-class="lead">{{ 'fulfillment_mailer.fulfilled_email.instructions' | t: number: order.number }}</mj-text>
    {% if fulfillment.delivery_method_name != blank %}
      <mj-text mj-class="lead">{{ 'fulfillment_mailer.fulfilled_email.delivery_method' | t: delivery_method: fulfillment.delivery_method_name }}</mj-text>
    {% endif %}
    {% if fulfillment.tracking != blank %}
      <mj-text mj-class="lead">{{ 'fulfillment_mailer.fulfilled_email.track_information' | t: tracking: fulfillment.tracking }}</mj-text>
    {% endif %}
    {% if fulfillment.tracking_url != blank %}
      <mj-button href="{{ fulfillment.tracking_url }}">{{ fulfillment.tracking | default: fulfillment.tracking_url }}</mj-button>
    {% endif %}
  </mj-column>
</mj-section>
{% render 'spree/shared/order_summary', heading: heading, purchase: order, items: fulfillment.manifest_items, totals: false %}
