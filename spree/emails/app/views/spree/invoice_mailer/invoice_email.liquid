---
subject: "{% if resend %}[{{ 'resend' | t }}] {% endif %}{{ store.name }} {% assign kind_key = 'invoice_mailer.invoice_email.kinds.' | append: invoice.kind %}{{ kind_key | t }} {{ invoice.number }}"
---
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'invoice_mailer.invoice_email.heading' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'invoice_mailer.invoice_email.dear_customer' | t: name: order.customer_name }}</mj-text>
    <mj-text mj-class="lead">{{ 'invoice_mailer.invoice_email.instructions' | t: number: invoice.number, order: order.number }}</mj-text>
  </mj-column>
</mj-section>
<mj-section padding="48px 0 0">
  <mj-column>
    {%- assign total = invoice.total | money -%}
    <mj-text mj-class="body" padding="0" font-weight="500" color="{{ store.branding.heading_color }}">{{ 'invoice_mailer.invoice_email.total' | t: total: total }}</mj-text>
    {%- if invoice.issuer_name -%}
    <mj-text mj-class="body" padding="8px 0 0">{{ 'invoice_mailer.invoice_email.issued_by' | t: issuer: invoice.issuer_name }}</mj-text>
    {%- endif -%}
  </mj-column>
</mj-section>
