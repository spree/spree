<% line_items.each do |item| %>
  <%= item.variant.sku %> <%= item.variant.product.name %> <%= item.variant.options_text -%> (<%=item.quantity%>) <%= Spree.t('at_symbol') %> <%= item.single_money %> = <%= item.display_amount %>
<% end %>
============================================================
<%= Spree.t('order_mailer.subtotal') %> <%= order.display_item_total %>
<% order.discounts.promotion.to_a.group_by(&:label).each do |label, discounts| %>
  <%= Spree.t(:promotion) %>: <%= label %> <%= Spree::Money.new(discounts.sum(&:amount), currency: order.currency) %>
<% end %>

<% order.fulfillments.group_by { |f| f.selected_delivery_rate.try(:name) }.each do |name, shipments| %>
  <%= Spree.t(:shipping) %>: <%= name %> <%= Spree::Money.new(shipments.sum(&:discounted_cost), currency: order.currency) %>
<% end %>

<% if order.additional_tax_total != 0 %>
  <%= Spree.t(:tax) %>: <%= order.display_additional_tax_total.to_html %>
<% end %>

<% if order.gift_card_total.positive? %>
  <%= Spree.t(:gift_card) %>: -<%= order.display_gift_card_total.to_html %>
<% end %>

<% order.discounts.manual.to_a.group_by(&:label).each do |label, discounts| %>
  <%= label %> <%= Spree::Money.new(discounts.sum(&:amount), currency: order.currency) %>
<% end %>
<% order.fees.each do |fee| %>
  <% next if fee.amount == 0 %>
  <%= fee.label %> <%= fee.display_amount %>
<% end %>
