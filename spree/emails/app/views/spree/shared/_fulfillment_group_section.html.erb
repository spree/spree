<%# One real parcel of a purchase, with the goods it carries and what it cost
    to deliver. Locals: fulfillment_group, position, count.

    A purchase arriving in one parcel is not numbered — "Delivery 1 of 1"
    tells the customer nothing they did not already assume.

    Rendered from the parcel's manifest rather than its line items: a line
    packed from two warehouses travels in two parcels, and its own quantity
    describes the whole order rather than this box. %>
<table class="section" width="100%" cellpadding="0" cellspacing="0" role="presentation">
  <tr>
    <td>
      <h3 class="f-fallback">
        <% if count > 1 %>
          <%= Spree.t('order_group_mailer.delivery_numbered', position: position, count: count) %>
        <% else %>
          <%= Spree.t('order_group_mailer.delivery') %>
        <% end %>
      </h3>
      <% if fulfillment_group.sellers.any? %>
        <p class="f-fallback sub"><%= Spree.t('order_group_mailer.sold_by', sellers: fulfillment_group.sellers.map(&:name).to_sentence) %></p>
      <% end %>
      <% fulfillment_group.manifest.each do |item| %>
        <%= render 'spree/shared/purchased_items_table/line_item',
                   line_item: item.line_item,
                   quantity: item.quantity,
                   amount: Spree::Money.new(item.line_item.price * item.quantity, currency: item.line_item.currency) %>
      <% end %>
      <table class="summary purchase_content" width="100%" cellpadding="0" cellspacing="0" role="presentation">
        <%= render 'spree/shared/purchased_items_table/summary_row',
                   label: Spree.t(:shipping),
                   sub: fulfillment_group.name,
                   value: fulfillment_group.display_cost %>
      </table>
    </td>
  </tr>
</table>
