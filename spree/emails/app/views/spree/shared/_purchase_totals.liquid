{%- comment -%}
  Every figure of an order or a purchase, once. Arguments: purchase.
{%- endcomment -%}
{%- assign tax_total = purchase.additional_tax_total | plus: 0 -%}
{%- assign gift_card_total = purchase.gift_card_total | plus: 0 -%}
<mj-table css-class="summary" padding="16px 0 0">
  {% render 'spree/shared/summary_row', label: 'order_mailer.subtotal', translate: true, value: purchase.display_item_total %}
  {%- for line in purchase.promotion_discounts -%}
    {% render 'spree/shared/summary_row', label: 'promotion', translate: true, sub: line.label, value: line.display_amount %}
  {%- endfor -%}
  {%- for line in purchase.delivery_lines -%}
    {% render 'spree/shared/summary_row', label: 'shipping', translate: true, sub: line.label, value: line.display_amount %}
  {%- endfor -%}
  {%- if tax_total != 0 -%}
    {% render 'spree/shared/summary_row', label: 'tax', translate: true, value: purchase.display_additional_tax_total %}
  {%- endif -%}
  {%- if gift_card_total > 0 -%}
    {%- assign gift_card_value = purchase.display_gift_card_total | prepend: '-' -%}
    {% render 'spree/shared/summary_row', label: 'gift_card', translate: true, value: gift_card_value %}
  {%- endif -%}
  {%- for line in purchase.manual_discounts -%}
    {% render 'spree/shared/summary_row', label: line.label, value: line.display_amount %}
  {%- endfor -%}
  {%- for line in purchase.fee_lines -%}
    {% render 'spree/shared/summary_row', label: line.label, value: line.display_amount %}
  {%- endfor -%}
  {% render 'spree/shared/summary_row', label: 'order_mailer.total', translate: true, value: purchase.display_total_minus_store_credits, total: true %}
</mj-table>
