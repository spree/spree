---
subject: "{{ store.name }} {{ 'company_mailer.invitation_email.subject' | t: company: company.name }}"
---
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'company_mailer.invitation_email.title' | t: company: company.name }}</mj-text>
    <mj-text mj-class="greeting">{{ 'company_mailer.invitation_email.greeting' | t }}</mj-text>
    <mj-text mj-class="lead">{{ 'company_mailer.invitation_email.instructions' | t: company: company.name, store: store.name }}</mj-text>
    <mj-button href="{{ accept_url }}">{{ 'company_mailer.invitation_email.action' | t }}</mj-button>
    <mj-text mj-class="note">{{ 'company_mailer.invitation_email.expiry_notice' | t }}</mj-text>
    <mj-text mj-class="note" padding="16px 0 0">{{ 'company_mailer.invitation_email.ignore_notice' | t }}</mj-text>
  </mj-column>
</mj-section>
