---
subject: "{% if resend %}[{{ 'resend' | t | upcase }}] {% endif %}{{ store.name }} {{ 'order_mailer.confirm_email.subject' | t }} #{{ order.number }}"
---
{% assign heading = 'order_mailer.confirm_email.order_summary' | t: number: order.number %}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'order_mailer.confirm_email.subject' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'order_mailer.confirm_email.dear_customer' | t: name: order.customer_name }}</mj-text>
    <mj-text mj-class="lead">{{ 'order_mailer.confirm_email.instructions' | t }}</mj-text>
  </mj-column>
</mj-section>
{% render 'spree/shared/order_summary', heading: heading, purchase: order, items: order.items, totals: true %}
