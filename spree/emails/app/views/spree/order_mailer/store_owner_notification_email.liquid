---
subject: "{{ 'order_mailer.store_owner_notification_email.subject' | t: store_name: store.name }}"
---
{% assign heading = 'order_mailer.store_owner_notification_email.order_summary' | t: number: order.number %}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'order_mailer.store_owner_notification_email.heading' | t }}</mj-text>
    <mj-text mj-class="lead">{{ 'order_mailer.store_owner_notification_email.instructions' | t }}</mj-text>
  </mj-column>
</mj-section>
{% render 'spree/shared/order_summary', heading: heading, purchase: order, items: order.items, totals: true %}
