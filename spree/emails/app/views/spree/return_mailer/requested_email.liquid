---
subject: "{{ store.name }} {{ 'return_mailer.requested_email.subject' | t: number: return.number }}"
---
{%- assign items_heading = 'return_mailer.requested_email.items' | t -%}
{%- assign placed_on = order.completed_at | date: 'long' -%}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">{{ 'return_mailer.requested_email.heading' | t }}</mj-text>
    <mj-text mj-class="greeting">{{ 'return_mailer.refunded_email.dear_customer' | t: name: order.customer_name }}</mj-text>
    <mj-text mj-class="lead">{{ 'return_mailer.requested_email.message' | t: number: return.number, order_number: order.number }}</mj-text>
    <mj-button href="{{ order_url }}">{{ 'return_mailer.requested_email.view_request' | t }}</mj-button>
  </mj-column>
</mj-section>
<mj-section padding="48px 0 0">
  <mj-column>
    <mj-text mj-class="section-heading" padding="0 0 16px">{{ 'return_mailer.requested_email.details' | t }}</mj-text>
    <mj-text mj-class="body" padding="0 0 4px">{{ 'return_mailer.requested_email.order_placed' | t: number: order.number, date: placed_on }}</mj-text>
    {%- if return.reason_name != blank -%}
      <mj-text mj-class="body" padding="0 0 4px">{{ 'return_mailer.requested_email.reason' | t: reason: return.reason_name }}</mj-text>
    {%- endif -%}
    {%- if return.memo != blank -%}
      <mj-text mj-class="body" padding="0 0 4px">{{ 'return_mailer.requested_email.note' | t: note: return.memo }}</mj-text>
    {%- endif -%}
    {%- if order.shipping_address -%}
      <mj-text mj-class="body" padding="0 0 4px">{{ 'return_mailer.requested_email.from' | t: name: order.shipping_address.full_name, address: order.shipping_address.address1, city: order.shipping_address.city }}</mj-text>
    {%- endif -%}
  </mj-column>
</mj-section>
{% render 'spree/shared/order_summary', heading: items_heading, purchase: order, items: return.items, totals: false %}
<mj-section padding="48px 0 0">
  <mj-column>
    <mj-text mj-class="section-heading" padding="0 0 16px">{{ 'return_mailer.requested_email.next_steps' | t }}</mj-text>
    <mj-text mj-class="body" padding="0 0 8px">{{ 'return_mailer.requested_email.next_steps_message' | t }}</mj-text>
    <mj-text mj-class="note"><a href="{{ policy_url }}">{{ 'return_mailer.requested_email.policy' | t }}</a></mj-text>
  </mj-column>
</mj-section>
