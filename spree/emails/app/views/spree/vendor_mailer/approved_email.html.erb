<%= render layout: 'spree/shared/mailer_hero' do %>
  <h1><%= Spree.t('vendor_mailer.approved_email.heading') %></h1>
  <p class="greeting"><%= Spree.t('vendor_mailer.greeting', vendor_name: @vendor.name) %></p>
  <p><%= Spree.t('vendor_mailer.approved_email.message', store_name: current_store.name) %></p>
  <% if @dashboard_url %>
    <%= render 'spree/shared/mailer_button', url: @dashboard_url, label: Spree.t('vendor_mailer.approved_email.action') %>
  <% end %>
<% end %>
