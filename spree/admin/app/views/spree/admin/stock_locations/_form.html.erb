<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">
      <%= Spree.t(:general_settings) %>
    </h5>
  </div>
  <div class="card-body" >
    <%= f.spree_text_field :name, required: true, autofocus: f.object.new_record? %>
    <%= f.spree_text_field :admin_name, label: Spree.t(:internal_name) %>
    <% unless f.object.default? %>
      <%= f.spree_check_box :active %>
    <% end %>
  </div>
</div>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">
      <%= Spree.t(:inventory) %>
    </h5>
  </div>
  <div class="card-body">
    <%= f.spree_check_box :propagate_all_variants, label: Spree.t('admin.stock_locations_form.propagate_all_variants_label') %>
    <small class="text-muted text-xs d-block"><%= Spree.t('admin.stock_locations_form.propagate_all_variants_hint') %></small>
    <div class="mt-2">
      <%= f.spree_check_box :backorderable_default, label: Spree.t('admin.stock_locations_form.backorderable_default_label') %>
      <small class="text-muted text-xs d-block"><%= Spree.t('admin.stock_locations_form.backorderable_default_hint') %></small>
    </div>
  </div>
</div>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">
      <%= Spree.t(:address) %>
    </h5>
  </div>
  <div class="card-body pb-0">
    <%= render 'spree/addresses/form',
                address_name: 'address',
                address_form: f,
                address_type: 'stock_location',
                address: f.object %>
  </div>
</div>
