{
  "name": "@spree/dashboard",
  "license": "MIT",
  "version": "1.0.0-rc.3",
  "description": "Spree Dashboard app shell — the next-gen React admin for Spree Commerce. Routes, resource hooks, schemas, locales, and the <Dashboard /> component. Source-only package; hosts compile it via @spree/dashboard/vite. Developer Preview.",
  "author": "Vendo Connect Inc.",
  "homepage": "https://spreecommerce.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/dashboard"
  },
  "keywords": [
    "spree",
    "commerce",
    "ecommerce",
    "admin",
    "dashboard",
    "react"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./vite": {
      "types": "./src/vite/index.ts",
      "default": "./dist/vite-plugin/index.js"
    },
    "./vite/route-collisions": {
      "types": "./src/vite/route-collisions.ts",
      "default": "./dist/vite-plugin/route-collisions.js"
    },
    "./components/spree/payment-method-editors/types": "./src/components/spree/payment-method-editors/types.ts",
    "./components/spree/auth-shell": "./src/components/spree/auth-shell.tsx",
    "./components/spree/store-setup-fields": "./src/components/spree/store-setup-fields.tsx",
    "./hooks/use-auth-providers": "./src/hooks/use-auth-providers.ts",
    "./schemas/auth": "./src/schemas/auth.ts"
  },
  "files": [
    "src",
    "dist/vite-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsup",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:first-run": "playwright test -c playwright.first-run.config.ts",
    "test:e2e:install": "playwright install chromium",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-hotkeys": "^0.14.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.46",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@uiw/react-json-view": "^1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "flag-icons": "^7.6.0",
    "lucide-react": "^1.58.0",
    "next-themes": "^0.4.6",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@spree/admin-sdk": "workspace:^",
    "@spree/dashboard-core": "workspace:^",
    "@spree/dashboard-plugin-example": "workspace:^",
    "@spree/dashboard-ui": "workspace:^",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.20",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.2.4",
    "tsup": "^9.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.3.4"
    }
  },
  "peerDependencies": {
    "@spree/admin-sdk": "workspace:^",
    "@spree/dashboard-core": "workspace:^",
    "@spree/dashboard-ui": "workspace:^",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.20"
  }
}
