{
  "name": "@spree/dashboard-core",
  "license": "MIT",
  "version": "1.0.0-rc.6",
  "description": "Spree Dashboard framework — registries (table, nav, slot, settings-nav), providers (auth, permission, store), admin SDK client, generic infra hooks, and the defineDashboardPlugin extension API. Developer Preview.",
  "author": "Vendo Connect Inc.",
  "homepage": "https://spreecommerce.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/dashboard-core"
  },
  "keywords": [
    "spree",
    "commerce",
    "ecommerce",
    "admin",
    "dashboard",
    "react",
    "plugin"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./api-client": "./src/api-client.ts",
    "./plugin": "./src/plugin.ts",
    "./vite": {
      "types": "./src/vite/index.ts",
      "default": "./dist/vite/index.js"
    },
    "./vite/discover": {
      "types": "./src/vite/discover.ts",
      "default": "./dist/vite/discover.js"
    },
    "./providers/*": "./src/providers/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./hooks/use-command-palette": "./src/hooks/use-command-palette.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./locales/en.json": "./src/locales/en.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome check src",
    "lint:fix": "biome check --fix src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@spree/admin-sdk": ">=1.0.0-rc.4 <2.0.0-0",
    "@spree/dashboard-ui": ">=0.10.0 <1.0.0-0 || >=1.0.0-0 <2.0.0-0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "i18next": "^26.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.8"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^6.0.0",
    "@spree/core": "workspace:^",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-hotkeys": "^0.16.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.60.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@spree/admin-sdk": "workspace:^",
    "@spree/dashboard-ui": "workspace:^",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^9.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
