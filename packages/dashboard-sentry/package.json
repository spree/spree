{
  "name": "@spree/dashboard-sentry",
  "license": "MIT",
  "version": "6.0.4",
  "description": "Sentry error tracking for the Spree admin dashboard and seller panel: one initDashboardSentry() call in the host's entry module.",
  "author": "Vendo Connect Inc.",
  "homepage": "https://spreecommerce.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/dashboard-sentry"
  },
  "keywords": [
    "spree",
    "dashboard",
    "plugin",
    "sentry",
    "error-tracking"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/react": "^11.12.0"
  },
  "peerDependencies": {
