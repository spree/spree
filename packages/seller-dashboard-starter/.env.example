# The Rails server the dev proxy forwards /api to. The panel stays same-origin
# with the API in dev, which is what lets the seller refresh cookie ride under
# SameSite=Lax without HTTPS.
#
# Do NOT set VITE_SPREE_API_URL here — it switches the SDK to absolute
# cross-origin URLs and bypasses this proxy.
VITE_API_PROXY_TARGET=http://localhost:3000
