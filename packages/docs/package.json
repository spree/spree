  "keywords": [
    "spree",
    "spree-commerce",
    "headless-commerce",
    "ecommerce",
    "ecommerce-api",
    "marketplace",
    "b2b-commerce",
    "wholesale",
    "documentation",
    "docs",
    "openapi",
    "ai-agents",
    "llm",
    "mcp"
  ],
  "type": "module",
  "license": "CC-BY-4.0",
  "author": "Vendo Connect Inc.",
  "homepage": "https://spreecommerce.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/docs"
  },
  "bugs": {
    "url": "https://github.com/spree/spree/issues"
  },
  "files": [
    "dist/**/*.md",
