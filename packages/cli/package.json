{
  "name": "@spree/cli",
  "version": "3.3.0",
  "description": "CLI for managing Spree Commerce projects",
  "type": "module",
  "bin": {
    "spree": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/bundle-spec.mjs && node ../../scripts/sync-starter.mjs templates/dashboard-starter && node ../../scripts/sync-starter.mjs templates/seller-dashboard-starter seller-dashboard-starter && tsup",
    "dev": "node scripts/bundle-spec.mjs && tsup --watch",
    "test": "node scripts/bundle-spec.mjs && vitest run",
    "typecheck": "node scripts/bundle-spec.mjs && tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --fix src tests",
    "format": "biome format --write src tests",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "generate:spec": "node scripts/bundle-spec.mjs"
  },
  "keywords": [
    "spree",
    "commerce",
    "ecommerce",
    "cli",
    "docker",
    "typescript"
  ],
  "author": "Vendo Connect Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/cli"
  },
  "homepage": "https://spreecommerce.org",
  "bugs": {
    "url": "https://github.com/spree/spree/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "^15.0.0",
    "console-table-printer": "^2.15.0",
    "execa": "^10.1.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@spree/admin-sdk": "workspace:^",
    "@spree/sdk-core": "workspace:*",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "yaml": "^2.8.4"
  },
  "engines": {
    "node": ">=20"
  }
}
