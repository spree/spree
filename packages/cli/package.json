{
  "name": "@spree/cli",
  "version": "3.7.0",
  "description": "CLI for Spree Commerce, the open-source headless commerce platform: runs the Docker image locally, generators, API keys and an Admin API client for scripts and AI agents",
  "type": "module",
  "bin": {
    "spree": "./bin/spree.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/bundle-spec.mjs && node ../../scripts/sync-starter.mjs templates/dashboard-starter && node ../../scripts/sync-starter.mjs templates/seller-dashboard-starter seller-dashboard-starter && tsup",
    "dev": "node scripts/bundle-spec.mjs && tsup --watch",
    "test": "node scripts/bundle-spec.mjs && vitest run",
    "typecheck": "node scripts/bundle-spec.mjs && tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --fix src tests",
    "format": "biome format --write src tests",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "generate:spec": "node scripts/bundle-spec.mjs"
  },
  "keywords": [
    "spree",
    "spree-commerce",
    "headless-commerce",
    "ecommerce",
    "ecommerce-api",
    "commerce",
    "marketplace",
    "b2b-commerce",
    "wholesale",
    "docker",
    "mcp",
    "cli",
    "typescript",
    "ai-agents"
  ],
  "author": "Vendo Connect Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/cli"
  },
  "homepage": "https://spreecommerce.org",
  "bugs": {
    "url": "https://github.com/spree/spree/issues"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "commander": "catalog:",
    "console-table-printer": "^2.15.0",
    "execa": "catalog:",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@spree/admin-sdk": "workspace:^",
    "@spree/config": "workspace:^",
    "@spree/sdk-core": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js"
  }
}
