{
  "$id": "https://spreecommerce.org/docs/schemas/spree-config/1.json",
  "title": "Spree store configuration",
  "description": "Declarative configuration of a Spree store, deployed with `spree config deploy`.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "store": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mail_from_address": {
          "type": "string"
        },
        "customer_support_email": {
          "type": "string"
        },
        "new_order_notifications_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferences": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Preferences without the `preferred_` prefix, e.g. `guest_checkout: false`."
        }
      },
      "additionalProperties": false,
      "description": "The store row seeded at install. Updated only; currency, locale and country are market attributes."
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "boolean"
          },
          "default": {
            "type": "boolean"
          },
          "stock_locations": {
            "description": "Stock location names.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preferences": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Preferences without the `preferred_` prefix, e.g. `guest_checkout: false`."
          }
        },
        "required": ["code", "name"],
        "additionalProperties": false
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "countries": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "default_locale": {
            "type": "string"
          },
          "supported_locales": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {
            "type": "boolean"
          },
          "tax_inclusive": {
            "type": "boolean"
          }
        },
        "required": ["name", "currency", "countries"],
        "additionalProperties": false
      }
    },
    "customer_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "tax_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tax_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "delivery_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "states": {
            "description": "State members, as country and state code pairs.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "state": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["country", "state"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "delivery_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "admin_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "delivery_zone": {
            "description": "Delivery zone name.",
            "type": "string",
            "minLength": 1
          },
          "calculator": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "Calculator type shorthand, e.g. `flat_rate`."
              },
              "preferences": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "storefront_visible": {
            "type": "boolean"
          },
          "available_to_sellers": {
            "type": "boolean"
          },
          "tracking_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "tax_category": {
            "description": "Tax category name.",
            "type": "string",
            "minLength": 1
          },
          "pickup_locations": {
            "description": "Stock location names a pickup method offers as collection points.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "estimated_transit_business_days_min": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "estimated_transit_business_days_max": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "stock_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "admin_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "active": {
            "type": "boolean"
          },
          "default": {
            "type": "boolean"
          },
          "kind": {
            "type": "string"
          },
          "backorderable_default": {
            "type": "boolean"
          },
          "propagate_all_variants": {
            "type": "boolean"
          },
          "pickup_enabled": {
            "type": "boolean"
          },
          "returns_enabled": {
            "type": "boolean"
          },
          "address1": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "address2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "zipcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contact_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "address1": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "address2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "postal_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "permalink": {
            "type": "string",
            "minLength": 1,
            "description": "Full path, e.g. `clothing/t-shirts`; the parent is the path without its last segment."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta_keywords": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["permalink", "name"],
        "additionalProperties": false
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "archived"]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "product_type": {
            "description": "Product type name.",
            "type": "string",
            "minLength": 1
          },
          "tax_category": {
            "description": "Tax category name.",
            "type": "string",
            "minLength": 1
          },
          "categories": {
            "description": "Category permalinks.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "channels": {
            "description": "Channel codes the product is published on.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "meta_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sku": {
            "description": "SKU of a simple product (one without option variants).",
            "type": "string",
            "minLength": 1
          },
          "prices": {
            "description": "Prices of a simple product.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "compare_at_prices": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "description": "Amount per currency, e.g. `{ USD: 29.99, EUR: 27.9 }`."
          },
          "stock": {
            "description": "Stock of a simple product.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "variants": {
            "description": "Option variants; the whole set, since variants absent here are removed.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Option type name to option value name, e.g. `{ size: S, color: Red }`."
                },
                "prices": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": "Amount per currency, e.g. `{ USD: 29.99, EUR: 27.9 }`."
                },
                "compare_at_prices": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": "Amount per currency, e.g. `{ USD: 29.99, EUR: 27.9 }`."
                },
                "stock": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "description": "Quantity on hand per stock location name."
                },
                "barcode": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "weight": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "height": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "width": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "depth": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "track_inventory": {
                  "type": "boolean"
                },
                "cost_price": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["sku"],
              "additionalProperties": false
            }
          }
        },
        "required": ["slug", "name"],
        "additionalProperties": false
      }
    },
    "customers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "password": {
            "description": "Set on create; never read back.",
            "type": "string",
            "minLength": 1
          },
          "accepts_email_marketing": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "customer_groups": {
            "description": "Customer group names.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["email"],
        "additionalProperties": false
      }
    },
    "sellers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "description": "Moves the seller through approve or suspend. A seller can be approved once onboarding has started; a freshly created one cannot.",
            "type": "string",
            "enum": ["approved", "suspended"]
          },
          "contact_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "billing_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "legal_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "registration_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "tax_remittance": {
            "type": "string"
          }
        },
        "required": ["slug", "name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version"],
  "additionalProperties": false
}
