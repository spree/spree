{
  "name": "create-spree-app",
  "version": "2.4.2",
  "description": "Create a Spree Commerce project with one command: the open-source headless commerce platform as a Docker image with REST Store and Admin APIs, TypeScript SDKs, an admin dashboard, an MCP server and a built-in marketplace. Needs only Node.js, Git and Docker",
  "type": "module",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --fix src tests",
    "format": "biome format --write src tests",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "spree",
    "spree-commerce",
    "headless-commerce",
    "ecommerce",
    "ecommerce-api",
    "commerce",
    "marketplace",
    "multi-vendor",
    "b2b",
    "docker",
    "mcp",
    "typescript",
    "nextjs",
    "scaffold",
    "create",
    "cli",
    "headless"
  ],
  "author": "Vendo Connect Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/create-spree-app"
  },
  "homepage": "https://spreecommerce.org",
  "bugs": {
    "url": "https://github.com/spree/spree/issues"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "commander": "catalog:",
    "execa": "catalog:",
    "get-port": "^7.2.0",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
