{
  "$id": "https://spreecommerce.org/docs/schemas/spree-config/1.json",
  "title": "Spree store configuration",
  "description": "Declarative configuration of a Spree store, deployed with `spree config deploy`.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "store": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mail_from_address": {
          "type": "string"
        },
        "customer_support_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_order_notifications_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferences": {
          "type": "object",
          "properties": {
            "admin_locale": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "timezone": {
              "type": "string"
            },
            "weight_unit": {
              "type": "string"
            },
            "unit_system": {
              "type": "string"
            },
            "storefront_access": {
              "type": "string",
              "enum": ["public", "prices_hidden", "login_required"]
            },
            "storefront_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "guest_checkout": {
              "type": "boolean"
            },
            "always_include_confirm_step": {
              "type": "boolean"
            },
            "company_field_enabled": {
              "type": "boolean"
            },
            "address_requires_company": {
              "type": "boolean"
            },
            "address_requires_phone": {
              "type": "boolean"
            },
            "capture_method": {
              "type": "string",
              "enum": ["checkout", "on_dispatch", "manual"]
            },
            "auto_capture_on_dispatch": {
              "type": "boolean"
            },
            "track_inventory_levels": {
              "type": "boolean"
            },
            "stock_reservations_enabled": {
              "type": "boolean"
            },
            "low_stock_threshold": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "tax_using_ship_address": {
              "type": "boolean"
            },
            "track_price_history": {
              "type": "boolean"
            },
            "show_products_without_price": {
              "type": "boolean"
            },
            "disable_sku_validation": {
              "type": "boolean"
            },
            "order_routing_strategy": {
              "type": "string"
            },
            "pricing_provider": {
              "type": "string"
            },
            "inventory_provider": {
              "type": "string"
            },
            "pricing_provider_failure_policy": {
              "type": "string",
              "enum": ["fallback", "strict"]
            },
            "inventory_provider_failure_policy": {
              "type": "string",
              "enum": ["fallback", "strict"]
            },
            "payout_provider": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "default_payouts_schedule_interval": {
              "type": "string",
              "enum": ["daily", "weekly", "biweekly", "monthly", "manual"]
            },
            "default_minimum_payout_amount": {
              "type": "number"
            },
            "auto_approve_sellers": {
              "type": "boolean"
            },
            "auto_approve_seller_products": {
              "type": "boolean"
            },
            "send_seller_transactional_emails": {
              "type": "boolean"
            },
            "send_consumer_transactional_emails": {
              "type": "boolean"
            },
            "default_commission_tax_rate": {
              "type": "number"
            },
            "document_number_format": {
              "type": "string",
              "enum": ["sequential", "random"]
            },
            "order_number_prefix": {
              "type": "string"
            },
            "order_number_suffix": {
              "type": "string"
            },
            "order_number_sequence_start": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false,
          "description": "Preferences without the `preferred_` prefix, e.g. `guest_checkout: false`."
        }
      },
      "additionalProperties": false,
      "description": "The store row seeded at install. Updated only; currency, locale and country are market attributes."
    },
    "stock_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "admin_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "active": {
            "type": "boolean"
          },
          "default": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": ["warehouse", "store", "fulfillment_center"]
          },
          "backorderable_default": {
            "type": "boolean"
          },
          "propagate_all_variants": {
            "type": "boolean"
          },
          "pickup_enabled": {
            "type": "boolean"
          },
          "returns_enabled": {
            "type": "boolean"
          },
          "address1": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "address2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "zipcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "boolean"
          },
          "default": {
            "type": "boolean"
          },
          "stock_locations": {
            "description": "Stock location names.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preferences": {
            "type": "object",
            "properties": {
              "order_routing_strategy": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "storefront_access": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["public", "prices_hidden", "login_required"]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "guest_checkout": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "description": "Preferences without the `preferred_` prefix, e.g. `guest_checkout: false`."
          }
        },
        "required": ["code", "name"],
        "additionalProperties": false
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "default_locale": {
            "type": "string"
          },
          "supported_locales": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {
            "type": "boolean"
          },
          "tax_inclusive": {
            "type": "boolean"
          },
          "countries": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        },
        "required": ["name", "currency", "countries"],
        "additionalProperties": false
      }
    },
    "customer_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "tax_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tax_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {
            "description": "Marks the store default tax category.",
            "type": "boolean"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "delivery_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": ["name"],
        "additionalProperties": false,
        "description": "`kind` is set when the profile is created and cannot change afterwards."
      }
    },
    "delivery_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "delivery_profile": {
            "description": "Delivery profile name.",
            "type": "string",
            "minLength": 1
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "all_countries_except": {
            "description": "Every country the store knows except these, e.g. an \"everywhere else\" zone.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "states": {
            "description": "State members, as country and state code pairs.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "state": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["country", "state"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "delivery_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "admin_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "fulfillment_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "storefront_visible": {
            "type": "boolean"
          },
          "available_to_sellers": {
            "type": "boolean"
          },
          "tracking_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "estimated_transit_business_days_min": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "estimated_transit_business_days_max": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "delivery_profile": {
            "description": "Delivery profile name.",
            "type": "string",
            "minLength": 1
          },
          "delivery_zone": {
            "description": "Delivery zone name.",
            "type": "string",
            "minLength": 1
          },
          "calculator": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "Calculator type shorthand, e.g. `flat_rate`."
              },
              "preferences": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "tax_category": {
            "description": "Tax category name.",
            "type": "string",
            "minLength": 1
          },
          "pickup_locations": {
            "description": "Stock location names a pickup method offers as collection points.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "package_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["box", "envelope", "carton", "pallet", "container"]
          },
          "length": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "dimensions_unit": {
            "type": "string",
            "enum": ["mm", "cm", "in", "ft"]
          },
          "weight": {
            "type": "number"
          },
          "max_weight": {
            "type": "number"
          },
          "weight_unit": {
            "type": "string",
            "enum": ["g", "kg", "lb", "oz"]
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "active": {
            "type": "boolean"
          },
          "storefront_visible": {
            "type": "boolean"
          },
          "capture_method": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["checkout", "on_dispatch", "manual"]
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Payment method type shorthand, e.g. `store_credit`. Set on create."
          }
        },
        "required": ["name", "type"],
        "additionalProperties": false
      }
    },
    "suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contact_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "address1": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "address2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "postal_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "product_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "delivery_profile": {
            "description": "Delivery profile name.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "permalink": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)*$",
            "description": "Full path, e.g. `clothing/t-shirts`; the parent is the path without its last segment."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "meta_title": {
            "type": "string"
          },
          "meta_description": {
            "type": "string"
          },
          "meta_keywords": {
            "type": "string"
          }
        },
        "required": ["permalink", "name"],
        "additionalProperties": false
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "archived"]
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "meta_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "product_type": {
            "description": "Product type name.",
            "type": "string",
            "minLength": 1
          },
          "tax_category": {
            "description": "Tax category name.",
            "type": "string",
            "minLength": 1
          },
          "categories": {
            "description": "Category permalinks.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "channels": {
            "description": "Channel codes the product is published on.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sku": {
            "description": "SKU of a simple product (one without option variants).",
            "type": "string",
            "minLength": 1
          },
          "prices": {
            "description": "Prices of a simple product.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "compare_at_prices": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "description": "Amount per currency, e.g. `{ USD: 29.99, EUR: 27.9 }`."
          },
          "stock": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
