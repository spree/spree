{
  "name": "@spree/seller-dashboard",
  "version": "1.0.0-rc.4",
  "license": "MIT",
  "type": "module",
  "description": "Spree marketplace seller panel — the seller-facing counterpart to the admin dashboard.",
  "homepage": "https://spreecommerce.org",
  "author": "Vendo Connect Inc.",
  "keywords": [
    "spree",
    "commerce",
    "ecommerce",
    "marketplace",
    "seller",
    "dashboard",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/seller-dashboard"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./vite": {
      "types": "./src/vite/index.ts",
      "default": "./dist/vite-plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/vite-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm generate:routes && tsup",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "generate:routes": "node scripts/generate-routes.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@spree/seller-sdk": "workspace:*",
    "@tanstack/router-plugin": "^1.167.35",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "lucide-react": "^1.47.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@spree/admin-sdk": "workspace:^",
    "@spree/dashboard-core": "workspace:^",
    "@spree/dashboard-ui": "workspace:^",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "i18next": "^26.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@spree/admin-sdk": "workspace:*",
    "@spree/dashboard-core": "workspace:*",
    "@spree/dashboard-ui": "workspace:*",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "i18next": "^26.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.8",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0"
  }
}
