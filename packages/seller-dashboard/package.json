{
  "name": "@spree/seller-dashboard",
  "version": "1.0.0-rc.6",
  "license": "MIT",
  "type": "module",
  "description": "Spree marketplace seller panel — the seller-facing counterpart to the admin dashboard.",
  "homepage": "https://spreecommerce.org",
  "author": "Vendo Connect Inc.",
  "keywords": [
    "spree",
    "commerce",
    "ecommerce",
    "marketplace",
    "seller",
    "dashboard",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/spree/spree.git",
    "directory": "packages/seller-dashboard"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./vite": {
      "types": "./src/vite/index.ts",
      "default": "./dist/vite-plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/vite-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm generate:routes && tsup",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "generate:routes": "node scripts/generate-routes.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@spree/core": "workspace:^",
    "@spree/seller-sdk": "workspace:*",
    "@tanstack/router-plugin": "^1.168.47",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "lucide-react": "^1.60.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@spree/admin-sdk": "workspace:^",
    "@spree/dashboard-core": "workspace:^",
    "@spree/dashboard-ui": "workspace:^",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "i18next": "^26.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@spree/admin-sdk": "workspace:*",
    "@spree/dashboard-core": "workspace:*",
    "@spree/dashboard-ui": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "i18next": "^26.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0",
    "tsup": "^9.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
